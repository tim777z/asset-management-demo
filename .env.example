# Example environment configuration for asset-manager.
# Copy to .env and adjust as needed:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env  (Windows)
#
# The CLI reads these from the process environment; it does not auto-load a
# .env file, so export them (or use your shell/CI to inject them).

# Logging verbosity used when neither --verbose nor --quiet is passed.
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO